{
  "context7": {
    "type": "remote",
    "url": "https://mcp.context7.com/mcp",
    "transport": "http",
    "enabled": true,
    "policy": {
      "read_only": true
    }
  },
  "ux-expert": {
    "command": "npx",
    "args": [
      "-y",
      "@elsahafy/ux-mcp-server"
    ],
    "transport": "stdio",
    "enabled": false
  },
  "sequential-thinking": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-sequential-thinking"
    ],
    "transport": "stdio",
    "enabled": false,
    "policy": {
      "read_only": true
    }
  },
  "_builtin_tools": {
    "download_file": false,
    "list_directory": false,
    "batch_web_search": false,
    "fetch_content": false,
    "crawl_site": false,
    "run_background_process": false,
    "safe_delete_directory": true,
    "write_file": true
  }
}
