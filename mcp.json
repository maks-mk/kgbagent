{
  "context7": {
    "type": "remote",
    "url": "https://mcp.context7.com/mcp",
    "transport": "http",
    "enabled": true,
    "policy": {
      "read_only": true
    }
  },
  "open-computer-use": {
    "command": "npx",
    "args": [
      "-y",
      "@qwen-code/open-computer-use",
      "mcp"
    ],
    "transport": "stdio",
    "enabled": false
  },
  "winapp-mcp": {
    "command": "npx",
    "args": [
      "-y",
      "winapp-mcp"
    ],
    "transport": "stdio",
    "enabled": false
  },
  "ddg-search": {
    "command": "uvx",
    "args": [
      "duckduckgo-mcp-server"
    ],
    "transport": "stdio",
    "enabled": false,
    "policy": {
      "read_only": true
    }
  },
  "windows-mcp": {
    "command": "uvx",
    "args": [
      "windows-mcp==0.8.7",
      "serve",
      "--tools",
      "Click,Type,Scroll,Move,Shortcut,Wait,WaitFor,DisplayInventory,Screenshot,Snapshot,App,MultiSelect,MultiEdit,Clipboard"
    ],
    "transport": "stdio",
    "enabled": false
  },
  "ssh-mcp": {
    "command": "./ssh-mcp/ssh-mcp.exe",
    "args": [],
    "transport": "stdio",
    "enabled": false,
    "cwd": "D:/py_projects/simple_ai_agent/agent+stategraph/lending",
    "env": {
      "SSH_MCP_LOCAL_ROOT": "D:/py_projects/simple_ai_agent/agent+stategraph/lending"
    }
  },
  "parallel-search": {
    "type": "remote",
    "url": "https://parallel.ai",
    "transport": "http",
    "enabled": false,
    "policy": {
      "read_only": true
    }
  },
  "_builtin_tools": {
    "download_file": false,
    "list_directory": false,
    "batch_web_search": false,
    "fetch_content": false,
    "crawl_site": false,
    "run_background_process": false,
    "safe_delete_directory": true,
    "write_file": true,
    "read_skills": false,
    "stop_background_process": false,
    "cli_exec": true,
    "read_images": false,
    "find_process_by_port": false
  }
}
