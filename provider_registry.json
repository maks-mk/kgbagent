{
  "schema_version": 1,
  "data_version": 5,
  "providers": [
    {
      "id": "openai",
      "enabled": true,
      "priority": 100,
      "match": [
        "api.openai.com",
		"agentrouter.org",
		"api.ashna.ai"
      ],
      "match_type": "exact",
      "supports_reasoning": true,
      "model_match": {
        "prefix": [
          "gpt-5",
		  "gpt-6",
          "o1",
          "o3",
          "o4"
        ]
      },
      "validation": "map",
      "reasoning": {
        "path": "reasoning.effort",
        "allowed_values": [
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "value_map": {},
        "none_value": "none",
        "extra_fields": {
          "reasoning.summary": "auto"
        }
      },
      "notes": "Native OpenAI Responses API through LangChain ChatOpenAI. reasoning.effort values are model-dependent; official vocabulary: none, minimal, low, medium, high, xhigh, max. Ref: platform.openai.com/docs/guides/reasoning."
    },
    {
      "id": "deepseek",
      "enabled": true,
      "priority": 99,
      "match": [
        "api.deepseek.com",
		"tokenharbor.ai"
      ],
      "match_type": "exact",
      "supports_reasoning": true,
      "model_match": {
        "prefix": [
          "deepseek-"
        ]
      },
      "validation": "map",
      "reasoning": {
        "path": "reasoning_effort",
        "allowed_values": [
          "low",
          "high",
          "max"
        ],
        "value_map": {
          "minimal": "low",
          "medium": "high",
          "xhigh": "max"
        },
        "extra_fields": {
          "extra_body.thinking.type": "enabled"
        }
      },
      "notes": "DeepSeek official Chat Completions thinking mode uses reasoning_effort=low|high|max and extra_body.thinking.type=enabled. Thinking mode does not support temperature or other sampling parameters. Ref: api-docs.deepseek.com/guides/thinking_mode."
    },
